# unifi-bridge: exposes the stdio `uvx unifi-network-mcp` server over Streamable HTTP
# so the gateway can reach UniFi as an HTTP upstream. UniFi credentials come from
# the STDIO_ENV env var (set via the quadlet EnvironmentFile).
FROM node:22-bookworm

# uv + uvx from the official image (no apt/pip needed)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:latest /uvx /usr/local/bin/uvx

WORKDIR /app
COPY package.json ./
RUN npm install && npm install --save-dev esbuild

COPY relay.ts ./
RUN npx esbuild relay.ts --bundle --platform=node --format=esm --packages=external --outfile=relay.js

ENV PORT=8644
EXPOSE 8644

CMD ["node", "relay.js"]
