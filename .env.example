# MCP Guard Gateway — environment template
# Copy to the gateway container's env file (e.g. ~/config/mcp-guard-gateway.env),
# fill in the values, chmod 600. Never commit this file.

# --- runtime ---
HOST=0.0.0.0
PORT=8080
DB_PATH=/data/gateway.db
PUBLIC_URL=https://mcp-guard.jaggi.xyz

# Master key used to encrypt secrets at rest (AES-256-GCM). Generate once:
#   openssl rand -hex 32
SECRET_MASTER_KEY=change-me

# --- OIDC (Authelia) ---
AUTHELIA_ISSUER=https://auth.jaggi.xyz
AUTHELIA_AUDIENCE=https://mcp-guard.jaggi.xyz
# AUTHELIA_JWKS_URL=https://auth.jaggi.xyz/api/oidc/jwks
# AUTHELIA_USERINFO_URL=https://auth.jaggi.xyz/api/oidc/userinfo

# --- Hermes HITL ---
HERMES_BRIDGE_URL=http://127.0.0.1:8643
HERMES_CONVERSATION_KEY=telegram:<your-telegram-user-id>

# --- RBAC (from Authelia forward-auth Remote-Groups header) ---
ADMIN_GROUPS=admins
OPERATOR_GROUPS=operators

# --- bootstrap upstream (seeded into the DB on first boot) ---
# UPSTREAM_URL=https://nanokvm-uttigen.jaggi.xyz/api/mcp
# UPSTREAM_NAMESPACE=nanokvm

# Note: per-upstream header secrets are managed via the admin UI (Settings -> Secrets)
# and referenced as $SECRET:NAME in the upstream header map (e.g. CF-Access-Client-Id).
