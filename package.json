{
  "name": "mcp-guard-gateway",
  "version": "0.1.0",
  "description": "Self-hosted gateway that secures HTTP MCP servers (NanoKVM and more) with per-tool governance, trust pinning, OIDC auth, Hermes-based HITL approvals, and an Angular admin UI.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "mcp",
    "gateway",
    "guard",
    "nanokvm",
    "hermes",
    "authelia",
    "oidc"
  ],
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.2",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
