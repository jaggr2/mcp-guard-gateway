{
  "name": "mcp-guard-gateway-browser",
  "version": "0.1.0",
  "private": true,
  "description": "browser-orchestrator: per-project Xvfb + Chromium + MCP session supervisor with noVNC takeover, CDP screencast, artifact capture, and a stateless MCP facade (Browser Broker).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
